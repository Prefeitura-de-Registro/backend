PORT=3000
DATABASE_URL="postgresql://admin:adminpassword@localhost:5432/lab_praticas?schema=public"
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
JWT_EXPIRES_IN="7d"

# CORS: origens permitidas separadas por vírgula (obrigatório em produção)
CORS_ORIGIN="http://localhost:5173"
# Atrás de proxy/load balancer (ex.: 1), para o rate limit ver o IP real
# TRUST_PROXY=1
# Pasta onde as imagens enviadas são gravadas
UPLOAD_DIR="uploads"
# URL do front, usada no link de acompanhamento de chamados anônimos
FRONTEND_URL="http://localhost:5173"
# Aviso "chamado próximo do prazo": % do prazo restante que dispara o aviso (padrão 20)
# PRAZO_ALERTA_PERCENTUAL=20
# PRAZO_ALERTA_DISABLED=true
