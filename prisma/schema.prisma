generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  municipe
  funcionario

  @@map("tipo_usuario_enum")
}

enum TicketStatus {
  aberto
  em_analise
  em_andamento
  pendente
  resolvido
  fechado

  @@map("ticket_status_enum")
}

enum TicketPrioridade {
  normal
  urgente

  @@map("ticket_prioridade_enum")
}

enum SolicitacaoStatus {
  pendente
  em_analise
  respondida
  recusada

  @@map("solicitacao_status_enum")
}

enum TipoEvento {
  criacao
  mudanca_status
  ajuste_prazo
  atribuicao

  @@map("tipo_evento_enum")
}

enum NotificacaoTipo {
  novo_ticket
  nova_solicitacao
  solicitacao_respondida

  @@map("notificacao_tipo_enum")
}

enum NotificacaoCanal {
  push
  email

  @@map("notificacao_canal_enum")
}

enum NotificacaoStatus {
  pendente
  enviada
  falhou
  lida

  @@map("notificacao_status_enum")
}

model Secretaria {
  id            Int            @id
  nome          String         @db.VarChar
  sigla         String?        @db.VarChar
  ativo         Boolean        @default(true)
  departamentos Departamento[]

  @@map("secretarias")
}

model Departamento {
  id                   Int                   @id
  idSecretaria         Int                   @map("id_secretaria")
  nome                 String                @db.VarChar
  sigla                String?               @db.VarChar
  ativo                Boolean               @default(true)
  secretaria           Secretaria            @relation(fields: [idSecretaria], references: [id])
  categorias           Categoria[]
  perguntasSolicitadas Pergunta[]            @relation("DepartamentoSolicitado")
  tickets              Ticket[]
  solicitacoes         Solicitacao[]
  usuarioDepartamentos UsuarioDepartamento[]

  @@index([idSecretaria])
  @@map("departamentos")
}

model User {
  id                      Int                   @id
  tipoUsuario             TipoUsuario           @default(municipe) @map("tipo_usuario")
  name                    String?               @map("nome") @db.VarChar
  email                   String?               @db.VarChar
  passwordHash            String?               @map("senha_hash") @db.VarChar
  reservado               Boolean               @default(false)
  ativo                   Boolean               @default(true)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  usuarioDepartamentos    UsuarioDepartamento[]
  ticketsCriados          Ticket[]              @relation("TicketCriadoPor")
  ticketsResponsaveis     Ticket[]              @relation("TicketResponsavel")
  historicos              TicketHistorico[]
  solicitacoesRespondidas Solicitacao[]         @relation("SolicitacaoRespondidaPor")
  mensagensSolicitacao    SolicitacaoMensagem[]
  notificacoes            Notificacao[]
  logsAuditoria           LogAuditoria[]

  @@map("usuarios")
}

model UsuarioDepartamento {
  id             Int          @id
  idUsuario      Int          @map("id_usuario")
  idDepartamento Int          @map("id_departamento")
  usuario        User         @relation(fields: [idUsuario], references: [id])
  departamento   Departamento @relation(fields: [idDepartamento], references: [id])

  @@unique([idUsuario, idDepartamento])
  @@index([idDepartamento])
  @@map("usuario_departamentos")
}

model Categoria {
  id                           Int          @id
  idDepartamento               Int          @map("id_departamento")
  nome                         String       @db.VarChar
  tempoPrimeiraRespostaMinutos Int          @map("tempo_primeira_resposta_minutos")
  tempoMaximoResolucaoMinutos  Int          @map("tempo_maximo_resolucao_minutos")
  tempoMinimoResolucaoMinutos  Int          @map("tempo_minimo_resolucao_minutos")
  tempoResolucaoUrgenteMinutos Int          @map("tempo_resolucao_urgente_minutos")
  ativo                        Boolean      @default(true)
  departamento                 Departamento @relation(fields: [idDepartamento], references: [id])
  perguntas                    Pergunta[]
  tickets                      Ticket[]

  @@index([idDepartamento])
  @@map("categorias")
}

model Pergunta {
  id                       Int           @id
  idCategoria              Int           @map("id_categoria")
  enunciado                String        @db.Text
  reducaoMinutos           Int           @default(0) @map("reducao_minutos")
  critica                  Boolean       @default(false)
  idDepartamentoSolicitado Int?          @map("id_departamento_solicitado")
  ordem                    Int           @default(0)
  categoria                Categoria     @relation(fields: [idCategoria], references: [id])
  departamentoSolicitado   Departamento? @relation("DepartamentoSolicitado", fields: [idDepartamentoSolicitado], references: [id])
  respostas                Resposta[]

  @@index([idCategoria])
  @@index([idDepartamentoSolicitado])
  @@map("perguntas")
}

model Ticket {
  id                           Int                                   @id
  idUsuario                    Int                                   @map("id_usuario")
  idCategoria                  Int                                   @map("id_categoria")
  idDepartamento               Int                                   @map("id_departamento")
  idFuncionarioResponsavel     Int?                                  @map("id_funcionario_responsavel")
  status                       TicketStatus                          @default(aberto)
  prioridade                   TicketPrioridade                      @default(normal)
  descricao                    String?                               @db.Text
  geom                         Unsupported("geography(Point,4326)")?
  tokenAcesso                  String?                               @unique @map("token_acesso") @db.VarChar
  prazoPrimeiraRespostaMinutos Int                                   @map("prazo_primeira_resposta_minutos")
  prazoResolucaoMinutos        Int                                   @map("prazo_resolucao_minutos")
  createdAt                    DateTime                              @default(now()) @map("created_at") @db.Timestamp(6)
  usuario                      User                                  @relation("TicketCriadoPor", fields: [idUsuario], references: [id])
  categoria                    Categoria                             @relation(fields: [idCategoria], references: [id])
  departamento                 Departamento                          @relation(fields: [idDepartamento], references: [id])
  funcionarioResponsavel       User?                                 @relation("TicketResponsavel", fields: [idFuncionarioResponsavel], references: [id])
  respostas                    Resposta[]
  historicos                   TicketHistorico[]
  solicitacoes                 Solicitacao[]
  arquivos                     Arquivo[]
  notificacoes                 Notificacao[]

  @@index([idUsuario])
  @@index([idCategoria])
  @@index([idDepartamento])
  @@index([idFuncionarioResponsavel])
  @@map("tickets")
}

model Resposta {
  id         Int      @id
  idPergunta Int      @map("id_pergunta")
  idTicket   Int      @map("id_ticket")
  valor      Boolean
  pergunta   Pergunta @relation(fields: [idPergunta], references: [id])
  ticket     Ticket   @relation(fields: [idTicket], references: [id])

  @@index([idPergunta])
  @@index([idTicket])
  @@map("respostas")
}

model TicketHistorico {
  id           Int           @id
  idTicket     Int           @map("id_ticket")
  tipoEvento   TipoEvento    @map("tipo_evento")
  status       TicketStatus?
  prazoMinutos Int?          @map("prazo_minutos")
  idUsuario    Int?          @map("id_usuario")
  texto        String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  ticket       Ticket        @relation(fields: [idTicket], references: [id])
  usuario      User?         @relation(fields: [idUsuario], references: [id])

  @@index([idTicket])
  @@index([idUsuario])
  @@map("ticket_historico")
}

model Solicitacao {
  id                       Int                   @id
  idTicket                 Int                   @map("id_ticket")
  idDepartamentoSolicitado Int                   @map("id_departamento_solicitado")
  status                   SolicitacaoStatus     @default(pendente)
  descricao                String                @db.Text
  resposta                 String?               @db.Text
  respondidoPor            Int?                  @map("respondido_por")
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  respondidoEm             DateTime?             @map("respondido_em") @db.Timestamp(6)
  ticket                   Ticket                @relation(fields: [idTicket], references: [id])
  departamentoSolicitado   Departamento          @relation(fields: [idDepartamentoSolicitado], references: [id])
  usuarioRespondedor       User?                 @relation("SolicitacaoRespondidaPor", fields: [respondidoPor], references: [id])
  mensagens                SolicitacaoMensagem[]
  notificacoes             Notificacao[]

  @@index([idTicket])
  @@index([idDepartamentoSolicitado])
  @@index([respondidoPor])
  @@map("solicitacoes")
}

model SolicitacaoMensagem {
  id            Int         @id
  idSolicitacao Int         @map("id_solicitacao")
  idUsuario     Int         @map("id_usuario")
  mensagem      String      @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  solicitacao   Solicitacao @relation(fields: [idSolicitacao], references: [id])
  usuario       User        @relation(fields: [idUsuario], references: [id])
  arquivos      Arquivo[]

  @@index([idSolicitacao])
  @@index([idUsuario])
  @@map("solicitacao_mensagens")
}

model Arquivo {
  id                    Int                  @id
  idTicket              Int?                 @map("id_ticket")
  idSolicitacaoMensagem Int?                 @map("id_solicitacao_mensagem")
  path                  String               @db.VarChar
  tipo                  String?              @db.VarChar
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  ticket                Ticket?              @relation(fields: [idTicket], references: [id])
  solicitacaoMensagem   SolicitacaoMensagem? @relation(fields: [idSolicitacaoMensagem], references: [id])

  @@index([idTicket])
  @@index([idSolicitacaoMensagem])
  @@map("arquivos")
}

model Notificacao {
  id            Int               @id
  idUsuario     Int               @map("id_usuario")
  tipoEvento    NotificacaoTipo   @map("tipo_evento")
  idTicket      Int?              @map("id_ticket")
  idSolicitacao Int?              @map("id_solicitacao")
  canal         NotificacaoCanal  @default(push)
  status        NotificacaoStatus @default(pendente)
  tentativas    Int               @default(0)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  enviadoEm     DateTime?         @map("enviado_em") @db.Timestamp(6)
  lidoEm        DateTime?         @map("lido_em") @db.Timestamp(6)
  usuario       User              @relation(fields: [idUsuario], references: [id])
  ticket        Ticket?           @relation(fields: [idTicket], references: [id])
  solicitacao   Solicitacao?      @relation(fields: [idSolicitacao], references: [id])

  @@index([idUsuario])
  @@index([idTicket])
  @@index([idSolicitacao])
  @@map("notificacoes")
}

model LogAuditoria {
  id           Int      @id
  idUsuario    Int?     @map("id_usuario")
  acao         String   @db.VarChar
  entidadeTipo String   @map("entidade_tipo") @db.VarChar
  entidadeId   Int      @map("entidade_id")
  dadosAntigos Json?    @map("dados_antigos") @db.JsonB
  dadosNovos   Json?    @map("dados_novos") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  usuario      User?    @relation(fields: [idUsuario], references: [id])

  @@index([idUsuario])
  @@map("logs_auditoria")
}
